{
  "name": "@keeless/sync",
  "version": "0.0.0",
  "private": true,
  "description": "sync library for keeless",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_sync --all-targets -- -D warnings",
    "test": "cargo test -p keeless_sync",
    "typecheck": "pnpm run \"/^typecheck:.*/\"",
    "typecheck:native": "cargo check -p keeless_sync --lib",
    "typecheck:wasm": "cargo check -p keeless_sync --lib --target wasm32-unknown-unknown"
  },
  "dependencies": {
    "@keeless/kdbx": "workspace:*"
  }
}

