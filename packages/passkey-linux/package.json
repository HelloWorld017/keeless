{
  "name": "@keeless/passkey-linux",
  "version": "0.0.0",
  "private": true,
  "description": "virtual FIDO2 authenticator serving keeless passkeys on linux",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cargo build --release -p keeless_passkey_linux",
    "build:dev": "cargo build -p keeless_passkey_linux",
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_passkey_linux --all-targets -- -D warnings",
    "test": "cargo test -p keeless_passkey_linux",
    "typecheck": "cargo check -p keeless_passkey_linux --lib"
  }
}
