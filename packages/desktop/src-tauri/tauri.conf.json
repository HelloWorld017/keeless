{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keeless",
  "version": "0.0.0",
  "identifier": "dev.nenw.keeless",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "keeless",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/keeless-daemon"]
  }
}
