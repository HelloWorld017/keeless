{
  "name": "@keeless/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "desktop application for keeless",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm run build && pnpm run \"/^dev:.*$/\"",
    "dev:main": "cross-env ELECTRON_RENDERER_URL=\"http://localhost:5173\" electron ./dist/main/index.js",
    "dev:renderer": "vite",
    "build": "pnpm run \"/^build:.*$/\"",
    "build:main": "vite build --ssr",
    "build:renderer": "vite build",
    "package": "pnpm run native:release && electron-vite build && electron-builder",
    "native:debug": "pnpm --filter @keeless/host-desktop build:debug && node scripts/stage-native-ui.mjs",
    "native:release": "pnpm --filter @keeless/host-desktop build && node scripts/stage-native-ui.mjs --release",
    "check": "pnpm run \"/^check:.*$/\"",
    "check:format": "pnpm run format --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "typecheck": "tsc --project tsconfig.json",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "pnpm run typecheck"
  },
  "dependencies": {
    "@keeless/app": "workspace:*",
    "@keeless/host-desktop": "workspace:*",
    "@keeless/lesswire": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@keeless/native-ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "catalog:",
    "electron-builder": "26.15.3",
    "vite": "catalog:"
  }
}
