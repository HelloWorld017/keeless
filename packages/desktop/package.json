{
  "name": "@keeless/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "desktop application for keeless",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:dev && pnpm run \"/^dev:.*$/\"",
    "dev:main": "cross-env ELECTRON_RENDERER_URL=\"http://localhost:5173\" electron ./dist/main/index.js",
    "dev:renderer": "vite",
    "build": "pnpm run \"/^build:(?!dev).*$/\"",
    "build:dev": "cross-env NODE_ENV=development pnpm run \"/^build:(main|preload).*$/\"",
    "build:main": "vite build --ssr",
    "build:renderer": "vite build",
    "build:preload": "vite build --mode preload",
    "check": "pnpm run \"/^check:.*$/\"",
    "check:format": "pnpm run format --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "dist": "pnpm run build && electron-builder",
    "typecheck": "tsc --project tsconfig.json",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "pnpm run typecheck"
  },
  "dependencies": {
    "@keeless/app": "workspace:*",
    "@keeless/host-desktop": "workspace:*",
    "@keeless/lesswire": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@keeless/native-ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "catalog:",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "vite": "catalog:"
  }
}
