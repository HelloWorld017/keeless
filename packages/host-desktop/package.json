{
  "name": "@keeless/host-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "native desktop host for keeless",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/keeless_host_desktop.node",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/keeless_host_desktop.node"
    }
  },
  "napi": {
    "binaryName": "keeless_host_desktop",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --release -o dist",
    "build:dev": "napi build -o dist",
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_host_desktop --all-targets -- -D warnings",
    "test": "cargo test -p keeless_host_desktop",
    "typecheck": "cargo check -p keeless_host_desktop --all-targets"
  },
  "dependencies": {
    "@keeless/core": "workspace:*",
    "@keeless/sync": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.4.0"
  }
}
