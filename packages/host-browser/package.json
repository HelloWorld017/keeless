{
  "name": "@keeless/host-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Rust/WASM browser host for Keeless",
  "license": "AGPL-3.0",
  "type": "module",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/keeless_host_browser.js"
    }
  },
  "scripts": {
    "build": "wasm-pack build --target web --out-dir dist --out-name keeless_host_browser",
    "check": "pnpm run '/^check:.*/'",
    "check:format": "cargo fmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "cargo check -p keeless_host_browser --target wasm32-unknown-unknown",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_host_browser --target wasm32-unknown-unknown --no-deps -- -D warnings",
    "test": "cargo test -p keeless_host_browser",
    "typecheck": "cargo check -p keeless_host_browser --lib --target wasm32-unknown-unknown"
  },
  "dependencies": {
    "@keeless/core": "workspace:*",
    "@keeless/lesswire": "workspace:*",
    "@keeless/sync": "workspace:*"
  }
}
