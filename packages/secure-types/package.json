{
  "name": "@keeless/secure-types",
  "version": "0.0.0",
  "private": true,
  "description": "memory security library for keeless",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_secure_types --all-targets -- -D warnings",
    "test": "cargo test -p keeless_secure_types",
    "typecheck": "pnpm run \"/^typecheck:.*/\"",
    "typecheck:native": "cargo check -p keeless_secure_types --lib",
    "typecheck:wasm": "cargo check -p keeless_secure_types --lib --target wasm32-unknown-unknown"
  }
}
