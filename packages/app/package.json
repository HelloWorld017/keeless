{
  "name": "@keeless/app",
  "version": "0.0.0",
  "private": true,
  "description": "keeless: minimal password manager",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm run '/^check:.*$/'",
    "check:lint": "pnpm run lint",
    "check:format": "pnpm run format --check",
    "check:type": "pnpm run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "generate": "simplei18n generate -D && oxfmt ./src/i18n",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@keeless/host-browser": "workspace:*",
    "@keeless/schema": "workspace:*",
    "@mesh-gradient/react": "^2.0.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@simplei18n/core": "^0.1.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.49.0",
    "fuzzysort": "^3.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.0"
  }
