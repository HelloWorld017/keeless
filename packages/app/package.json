{
  "name": "@keeless/app",
  "version": "0.0.0",
  "private": true,
  "description": "keeless: minimal password manager",
  "license": "AGPL-3.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run \"/^build:.*$/\"",
    "build:app": "vite build",
    "build:lib": "vite build --mode lib",
    "check": "pnpm run \"/^check:.*$/\"",
    "check:lint": "pnpm run lint",
    "check:format": "pnpm run format --check",
    "check:type": "pnpm run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "generate": "simplei18n generate -D && oxfmt ./src/i18n",
    "typecheck": "tsgo --project tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@keeless/host-browser": "workspace:*",
    "@keeless/lesswire": "workspace:*",
    "@keeless/schema": "workspace:*",
    "@simplei18n/core": "0.1.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "3.14.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "es-toolkit": "1.49.0",
    "lucide-react": "1.26.0",
    "qrescan": "0.4.0",
    "react": "catalog:",
    "react-day-picker": "10.0.1",
    "react-dom": "catalog:",
    "shadcn": "4.14.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "wouter": "3.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.0.4",
    "rolldown-plugin-dts": "0.27.13",
    "tailwindcss": "4.3.3",
    "vite": "catalog:"
  }
}
