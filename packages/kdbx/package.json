{
  "name": "@keeless/kdbx",
  "version": "0.0.0",
  "private": true,
  "description": "kdbx library for keeless",
  "license": "MIT OR MulanPSL-2.0",
  "type": "module",
  "scripts": {
    "build": "cargo build --release -p keeless_kdbx",
    "check": "pnpm run '/^check:.*/'",
    "check:lint": "pnpm run lint",
    "check:wasm": "cargo check -p keeless_kdbx --lib --target wasm32-unknown-unknown",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_kdbx --all-targets -- -D warnings",
    "test": "cargo test -p keeless_kdbx"
  },
  "dependencies": {
    "@keeless/secure-types": "workspace:*"
  }
}
