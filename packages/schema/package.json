{
  "name": "@keeless/schema",
  "version": "0.0.0",
  "private": true,
  "description": "shared protocol types for keeless",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "pnpm run build",
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check && oxfmt --check src/index.ts",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt && oxfmt src/index.ts",
    "generate": "cargo run --bin export-types && oxfmt src/index.ts",
    "lint": "cargo clippy -p keeless_schema --all-targets -- -D warnings",
    "test": "cargo test -p keeless_schema",
    "typecheck": "pnpm run \"/^typecheck:.*/\"",
    "typecheck:native": "cargo check -p keeless_schema --lib",
    "typecheck:wasm": "cargo check -p keeless_schema --lib --target wasm32-unknown-unknown"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  }
}
