{
  "name": "@keeless/schema",
  "version": "0.0.0",
  "private": true,
  "description": "shared protocol types for keeless",
  "license": "MIT",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "files": [
    "index.ts"
  ],
  "scripts": {
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check && oxfmt --check index.ts",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt && oxfmt index.ts",
    "generate": "cargo run --bin export-types && oxfmt index.ts",
    "lint": "cargo clippy -p keeless_schema --all-targets -- -D warnings",
    "test": "cargo test -p keeless_schema",
    "typecheck": "pnpm run \"/^typecheck:.*/\"",
    "typecheck:native": "cargo check -p keeless_schema --lib",
    "typecheck:wasm": "cargo check -p keeless_schema --lib --target wasm32-unknown-unknown"
  }
}
