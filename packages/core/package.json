{
  "name": "@keeless/core",
  "version": "0.0.0",
  "private": true,
  "description": "host-independent backend for keeless",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "cargo build --release -p keeless_core",
    "check": "pnpm run '/^check:.*/'",
    "check:format": "cargo fmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "cargo fmt",
    "lint": "cargo clippy -p keeless_core --all-targets -- -D warnings",
    "test": "cargo test -p keeless_core --lib",
    "typecheck": "pnpm run '/^typecheck:.*/'",
    "typecheck:native": "cargo check -p keeless_core --lib",
    "typecheck:wasm": "cargo check -p keeless_core --lib --target wasm32-unknown-unknown"
  },
  "dependencies": {
    "@keeless/kdbx": "workspace:*",
    "@keeless/secure-types": "workspace:*",
    "@keeless/schema": "workspace:*",
    "@keeless/sync": "workspace:*"
  }
}
