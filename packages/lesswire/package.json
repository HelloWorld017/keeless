{
  "name": "@keeless/lesswire",
  "version": "0.0.0",
  "private": true,
  "description": "wire protocol for keeless",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "pnpm run \"/^build:.*$/\"",
    "build:rust": "cargo build --release -p keeless_lesswire",
    "build:lib": "tsdown",
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "cargo fmt --check && oxfmt --check",
    "check:lint": "pnpm run lint",
    "check:type": "pnpm run typecheck",
    "format": "pnpm run \"/^format:.*/\"",
    "format:rust": "cargo fmt",
    "format:ts": "oxfmt",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:rust": "cargo clippy -p keeless_lesswire --all-targets -- -D warnings",
    "lint:ts": "oxlint",
    "test": "cargo test -p keeless_lesswire",
    "typecheck": "pnpm run \"/^typecheck:.*/\"",
    "typecheck:rust": "cargo check -p keeless_lesswire",
    "typecheck:ts": "tsgo --project tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "tsdown": "0.22.13"
  }
}
