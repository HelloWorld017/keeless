{
  "name": "keeless-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "KeePass database editor",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @keeless/app dev",
    "build": "pnpm -r build",
    "check": "pnpm run '/check:.*/'",
    "check:lint": "pnpm run lint",
    "check:format": "pnpm run format",
    "check:type": "pnpm run typecheck",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.9.0"
}
