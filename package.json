{
  "name": "@keeless/root",
  "version": "0.1.0",
  "private": true,
  "description": "keeless: modern password manager",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:dev": "pnpm -r build:dev",
    "build:linux": "pnpm --filter @keeless/desktop... --filter \"!@keeless/*-windows\" run build",
    "build:windows": "pnpm --filter @keeless/desktop... --filter \"!@keeless/*-linux\" run build",
    "dist:linux": "pnpm run build:linux && pnpm --filter @keeless/desktop run dist:linux",
    "dist:nix": "pnpm run build:linux && pnpm --filter @keeless/desktop run dist:nix",
    "dist:windows": "pnpm run build:windows && pnpm --filter @keeless/desktop run dist:windows",
    "check": "pnpm -r check",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.9.0"
}
